{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../contracts/**",
        "../../config/release/version.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../contracts/**",
        "../../config/release/version.json"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../contracts/**",
        "../../config/release/version.json"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": [
        "coverage/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../contracts/**",
        "../../config/release/version.json"
      ]
    }
  },
  "globalDependencies": [
    "package.json",
    "pnpm-workspace.yaml",
    "config/monorepo/policy.json",
    "config/release/version.json"
  ]
}
