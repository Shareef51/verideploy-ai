{
  "$defs": {
    "CitationReference": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Citation Id",
          "type": "string"
        },
        "claim_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "document",
            "log",
            "metric",
            "trace",
            "image",
            "audio",
            "video",
            "code",
            "release"
          ],
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "evidence_id",
        "source_type",
        "locator"
      ],
      "title": "CitationReference",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "citation_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Citation Ids",
          "type": "array"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "provenance_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provenance Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "summary",
        "provenance_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ReviewResponse": {
      "additionalProperties": false,
      "properties": {
        "decided_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided At"
        },
        "decision_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Reason"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "review_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Id"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Id"
        },
        "signature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature Id"
        },
        "status": {
          "$ref": "#/$defs/ReviewStatus"
        }
      },
      "required": [
        "status",
        "required"
      ],
      "title": "ReviewResponse",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "NOT_REQUIRED",
        "PENDING",
        "APPROVED",
        "REJECTED",
        "CHANGES_REQUESTED",
        "EXPIRED"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "RiskBand": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskBand",
      "type": "string"
    },
    "RiskDecision": {
      "enum": [
        "PROCEED",
        "PROCEED_WITH_GUARDRAILS",
        "DELAY",
        "BLOCK"
      ],
      "title": "RiskDecision",
      "type": "string"
    }
  },
  "$id": "https://schemas.verideploy.ai/final/release-risk-response.v1.json",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "format": "uuid",
      "title": "Assessment Id",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/CitationReference"
      },
      "title": "Citations",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/RiskDecision"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence",
      "type": "array"
    },
    "recommended_actions": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Actions",
      "type": "array"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/ReviewResponse"
    },
    "risk_band": {
      "$ref": "#/$defs/RiskBand"
    },
    "risk_factors": {
      "items": {
        "type": "string"
      },
      "title": "Risk Factors",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "integer"
    },
    "status": {
      "const": "COMPLETED",
      "default": "COMPLETED",
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "tenant_id",
    "correlation_id",
    "release_id",
    "score",
    "risk_band",
    "decision",
    "confidence",
    "summary",
    "risk_factors",
    "recommended_actions",
    "evidence",
    "citations",
    "review",
    "completed_at"
  ],
  "title": "ReleaseRiskFinalResponse",
  "type": "object"
}
