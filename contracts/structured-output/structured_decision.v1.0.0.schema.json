{
  "$defs": {
    "DecisionEscalate": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "const": "escalate",
          "title": "Decision",
          "type": "string"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Missing Evidence",
          "type": "array"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale",
        "missing_evidence"
      ],
      "title": "DecisionEscalate",
      "type": "object"
    },
    "DecisionProceed": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "const": "proceed",
          "title": "Decision",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale",
        "evidence_ids"
      ],
      "title": "DecisionProceed",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "result": {
      "discriminator": {
        "mapping": {
          "escalate": "#/$defs/DecisionEscalate",
          "proceed": "#/$defs/DecisionProceed"
        },
        "propertyName": "decision"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DecisionProceed"
        },
        {
          "$ref": "#/$defs/DecisionEscalate"
        }
      ],
      "title": "Result"
    }
  },
  "required": [
    "result",
    "confidence"
  ],
  "title": "StructuredDecisionOutput",
  "type": "object"
}
