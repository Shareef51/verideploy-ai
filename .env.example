APP_NAME=VeriDeploy AI
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=change-me-in-local-env
LOG_LEVEL=INFO
WEB_BASE_URL=http://localhost:3000
GATEWAY_BASE_URL=http://localhost:4000
AI_SERVICE_BASE_URL=http://ai-service:8000
INTERNAL_SERVICE_AUTH_REQUIRED=false
INTERNAL_SERVICE_AUTH_SECRET=replace-with-shared-internal-service-secret
INTERNAL_SERVICE_AUTH_MAX_SKEW_SECONDS=60
AI_SERVICE_TIMEOUT_MS=5000
AI_SERVICE_MAX_ATTEMPTS=2
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=verideploy-api
DATABASE_URL=postgresql+psycopg://verideploy:verideploy@postgres:5432/verideploy
REDIS_URL=redis://redis:6379/0
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=verideploy
KAFKA_CONSUMER_GROUP=verideploy-local
SCHEMA_REGISTRY_URL=http://schema-registry:8081
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=verideploy-evidence
S3_ACCESS_KEY=verideploy-local
S3_SECRET_KEY=replace-in-local-env
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=
OPENAI_STANDARD_MODEL=
OPENAI_FAST_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=128
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_MAX_ATTEMPTS=3
VECTOR_INDEX_CONFIG_PATH=config/vector-index.json
RETRIEVAL_RRF_K=60
RETRIEVAL_CANDIDATE_K=60
RETRIEVAL_MAX_PER_SOURCE=2
RETRIEVAL_CACHE_TTL_SECONDS=300
RETRIEVAL_INDEX_VERSION=embedding_index_v1
RETRIEVAL_CORPUS_VERSION=1.0.0
RETRIEVAL_PIPELINE_VERSION=1.0.0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
DB_POOL_RECYCLE_SECONDS=1800
DB_SLOW_QUERY_THRESHOLD_MS=750
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=120
OPENAI_TRANSCRIPTION_MODEL=
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_TIMEOUT_SECONDS=120
TRANSCRIPTION_PII_PATTERNS_JSON=[]
TRANSCRIPTION_RESPONSE_MODE=timestamped
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
JIRA_URL=
JIRA_TOKEN=
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
GRAFANA_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=verideploy
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=verideploy-ai
DEMO_MODE=true
SYNTHETIC_DATA_SEED=8421
REQUIRE_HUMAN_APPROVAL_AT_RISK_SCORE=80
ENABLE_EXTERNAL_WEB_SEARCH=false
ENABLE_VISUAL_RETRIEVER=false
MAX_DOCUMENT_UPLOAD_BYTES=26214400
MAX_IMAGE_UPLOAD_BYTES=26214400
MAX_AUDIO_UPLOAD_BYTES=104857600
MAX_VIDEO_UPLOAD_BYTES=524288000
AI_PROVIDER=openai
AI_CONTROL_BACKEND=memory
AI_TIMEOUT_SECONDS=45
AI_MAX_ATTEMPTS=3
AI_REQUESTS_PER_MINUTE=60
AI_MONTHLY_BUDGET_USD=250.00
AI_DEFAULT_ESTIMATED_REQUEST_COST_USD=0.01

# model routing and cost policy
OPENAI_FAST_FALLBACK_MODELS=
OPENAI_STANDARD_FALLBACK_MODELS=
OPENAI_REASONING_FALLBACK_MODELS=
AI_FAST_CONCURRENCY=16
AI_STANDARD_CONCURRENCY=8
AI_REASONING_CONCURRENCY=4
AI_PRICING_CATALOG_PATH=config/model-pricing.json
AI_ALLOW_UNPRICED_MODELS=false
AI_OPERATION_ROLE_OVERRIDES_JSON={}

# image-intelligence safety/detail policy
AI_IMAGE_DEFAULT_DETAIL=auto
AI_IMAGE_ALLOW_ORIGINAL_DETAIL=false
AI_IMAGE_MAX_PIXELS=40000000
AI_IMAGE_MAX_SIDE=8192

# visual document retrieval
VISUAL_RETRIEVAL_BACKEND=cpu_fallback
VISUAL_RETRIEVAL_MODEL=vidore/colpali-v1.3-hf
VISUAL_RETRIEVAL_DPI=144
VISUAL_RETRIEVAL_MAX_PAGES=500
VISUAL_RETRIEVAL_PAGE_ROOT=data/processed/visual_pages
VISUAL_RETRIEVAL_INDEX_ROOT=data/processed/visual_index

# multimodal RAG fusion budgets
RAG_CONTEXT_MAX_TOKENS=8000
RAG_CONTEXT_MAX_IMAGES=4
RAG_CONTEXT_MAX_EVIDENCE=20
RAG_CONTEXT_MAX_PER_CHANNEL=8

# video evidence
VIDEO_MAX_DURATION_SECONDS=3600
VIDEO_SCENE_THRESHOLD=0.35
VIDEO_KEYFRAME_INTERVAL_SECONDS=10
VIDEO_MAX_KEYFRAMES=60
VIDEO_ALIGNMENT_WINDOW_SECONDS=5
VIDEO_FRAME_ROOT=data/processed/video_frames

# LangGraph durable runtime
LANGGRAPH_DEFAULT_TIMEOUT_SECONDS=300
LANGGRAPH_DURABILITY=sync
LANGGRAPH_STATE_ENCRYPTION_POLICY=reference_only

# agent governance
AGENT_DEFAULT_TOOL_BUDGET=8
AGENT_MAX_PLAN_TOOL_CALLS=12
RAG_AGENT_TOOL_BUDGET=4
RAG_AGENT_MIN_EVIDENCE=2
RAG_AGENT_MIN_SOURCES=1

# VisualEvidenceAgent
VISUAL_AGENT_TOOL_BUDGET=4
VISUAL_AGENT_MAX_ANALYSES=3
VISUAL_AGENT_MIN_SHORT_SIDE=720
VISUAL_AGENT_MIN_CONFIDENCE=0.55

# RuntimeEvidenceAgent
RUNTIME_EVIDENCE_ADAPTER=synthetic
RUNTIME_AGENT_TOOL_BUDGET=4
RUNTIME_AGENT_MIN_EVIDENCE=1
RUNTIME_AGENT_MIN_SOURCES=1
RUNTIME_ANOMALY_Z_THRESHOLD=2.0
RUNTIME_ANOMALY_PERCENT_THRESHOLD=50.0
RUNTIME_HTTP_TIMEOUT_SECONDS=15
PROMETHEUS_BASE_URL=http://prometheus:9090
GRAFANA_BASE_URL=http://grafana:3000
TEMPO_BASE_URL=http://tempo:3200
LOKI_BASE_URL=http://loki:3100
RUNTIME_OBSERVABILITY_TOKEN=

# RCAAgent
RCA_AGENT_MIN_ROOT_SUPPORT=2
RCA_AGENT_MIN_CONFIDENCE=0.55
RCA_AGENT_MAX_EVIDENCE=40
CRITIC_AGENT_TOOL_BUDGET=2
CRITIC_MAX_FOLLOWUPS=2
CRITIC_FOLLOWUP_TOP_K=4
CRITIC_ENTAILMENT_THRESHOLD=0.18
CRITIC_PARTIAL_ENTAILMENT_THRESHOLD=0.08
CRITIC_PASS_CONFIDENCE=0.55

# MCP secure gateway
MCP_TOOL_TIMEOUT_SECONDS=15
MCP_CIRCUIT_BREAKER_THRESHOLD=3
MCP_CIRCUIT_BREAKER_RESET_SECONDS=30
MCP_EXTERNAL_WRITES_ENABLED=false
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TOKEN=

# real engineering data integrations
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_AUTH_MODE=basic
INTEGRATION_ALLOWED_HOSTS=api.github.com,localhost,prometheus,grafana,tempo,loki
INTEGRATION_HTTP_TIMEOUT_SECONDS=15
INTEGRATION_MAX_ATTEMPTS=3
INTEGRATION_MAX_REQUESTS_PER_RUN=50
INTEGRATION_BACKOFF_BASE_SECONDS=0.25
INTEGRATION_MAX_RETRY_DELAY_SECONDS=60

# retrieval pipeline orchestration
RETRIEVAL_PIPELINE_TOP_K=8
RETRIEVAL_PIPELINE_MAX_EXPANSIONS=2
RETRIEVAL_PIPELINE_MIN_RERANK_SCORE=0.10

# self-corrective RAG
SELF_CORRECTIVE_RAG_MAX_ATTEMPTS=3
SELF_CORRECTIVE_RAG_MAX_QUERY_REWRITES=2
SELF_CORRECTIVE_RAG_ALLOW_SCOPE_RELAXATION=true
SELF_CORRECTIVE_RAG_EXTERNAL_SEARCH_MODE=disabled

# Hallucination protection
HALLUCINATION_SUPPORTED_THRESHOLD=0.68
HALLUCINATION_UNCERTAIN_THRESHOLD=0.42
HALLUCINATION_CONTRADICTION_THRESHOLD=0.65
HALLUCINATION_UNSUPPORTED_MATERIAL_THRESHOLD=0.05

# permission-safe citation previews through the public gateway.
# These are server-side gateway defaults; the browser cannot grant itself retrieval permissions.
GATEWAY_RETRIEVAL_PERMISSIONS=retrieval.read,retrieval.preview.read
GATEWAY_ALLOWED_SERVICES=
GATEWAY_ALLOWED_ENVIRONMENTS=
GATEWAY_ALLOWED_TEAMS=
GATEWAY_ALLOWED_DOCUMENT_KINDS=

# dynamic parallelism
LANGGRAPH_PARALLEL_MAX_CONCURRENCY=8
LANGGRAPH_PARALLEL_MAX_TASKS=16
LANGGRAPH_PARALLEL_DEFAULT_DEADLINE_SECONDS=30
LANGGRAPH_PARALLEL_MAX_DEADLINE_SECONDS=120

# human approval
APPROVAL_DEFAULT_EXPIRY_SECONDS=3600
# Optional dedicated HMAC key; falls back to APP_SECRET_KEY.
APPROVAL_SIGNING_SECRET=
GATEWAY_APPROVAL_REVIEWER_ID=demo-reviewer
GATEWAY_APPROVAL_REVIEWER_ROLES=release_reviewer

# workflow durability
WORKFLOW_LEASE_TTL_SECONDS=30
WORKFLOW_HEARTBEAT_SECONDS=10
WORKFLOW_STUCK_GRACE_SECONDS=5
WORKFLOW_STEP_DEFAULT_TIMEOUT_SECONDS=60
WORKFLOW_RETRY_MAX_ATTEMPTS=3
WORKFLOW_RETRY_BASE_SECONDS=1

# Next.js production frontend foundation
# Must be a high-entropy secret in deployed environments. The browser never receives it.
FRONTEND_SESSION_SECRET=replace-with-high-entropy-frontend-session-secret
# Explicit local-only escape hatch; production validation forbids enabling this.
FRONTEND_DEV_AUTH_BYPASS=false
FRONTEND_DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
FRONTEND_DEV_USER_ID=22222222-2222-4222-8222-222222222222
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:4000

# LangSmith integration. Disabled by default; observability only.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT_PREFIX=verideploy
LANGSMITH_DATASET_EXPORT_ENABLED=false
LANGSMITH_DATASET_PREFIX=verideploy-evals


# OpenTelemetry distributed tracing
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXCLUDED_URLS=health/live,health/ready
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SERVICE_NAME=verideploy-gateway
NEXT_PUBLIC_OTEL_ENABLED=true
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Production security architecture
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=verideploy-api
GATEWAY_DEV_AUTH_BYPASS=false
GATEWAY_DEV_USER_ID=22222222-2222-4222-8222-222222222222
GATEWAY_DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
CORS_ALLOWED_ORIGINS=http://localhost:3000
CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; img-src 'self' data: blob:; connect-src 'self' http://localhost:4000 ws://localhost:4000; script-src 'self'; style-src 'self' 'unsafe-inline'
# Production must use an external secret-manager reference rather than plaintext application secrets.
PRODUCTION_SECRET_PROVIDER=
KMS_KEY_REFERENCE=
DATABASE_TLS_REQUIRED=true
OBJECT_STORE_SSE_REQUIRED=true
# Prefer one credential per private service in staging/production; JSON values come from the deployment secret manager.
INTERNAL_SERVICE_AUTH_SECRETS_JSON={}
